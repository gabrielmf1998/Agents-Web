#!/usr/bin/env bash
# agents-web: start Agents Web, or open it when it is already running.
# https://github.com/gabrielmf1998/Agents-Web (MIT license)
set -u
# set by install.sh and the packages to where the app lives
APP_DEFAULT="$HOME/.local/opt/agents-web"
APP="${AGENTS_WEB_HOME:-$APP_DEFAULT}"
PORT="${AGENTS_WEB_PORT:-47830}"
KIND="$(cat "$APP/install-kind" 2>/dev/null || echo script)"

usage() {
    cat <<EOF
Usage: agents-web [command]

  start      start the service and the tray icon, then open the page (default)
  open       same as start
  stop       stop the service and every agent it is running
  restart    stop, then start again without opening the page
  status     tell whether it is running
  log        follow the server log
  version    print the installed version
  update     download and install the latest release (checked against its SHA256 sum)
  uninstall  remove the app (chats and settings are kept, see --purge in the README)
EOF
}

running() { pgrep -u "$(id -u)" -x agents-web-tray >/dev/null; }
version() { sed -n 's/^VERSAO = "\(.*\)"/\1/p' "$APP/server.py"; }

stop() {
    running || return 1
    pkill -u "$(id -u)" -x agents-web-tray
    for _ in $(seq 1 50); do running || return 0; sleep 0.1; done
    return 0
}

case "${1:-start}" in
    start|open)
        [ -x "$APP/agents-web-tray" ] || { echo "Agents Web is not installed in $APP" >&2; exit 1; }
        setsid -f "$APP/agents-web-tray" --open >/dev/null 2>&1
        echo "Agents Web: http://127.0.0.1:$PORT/" ;;
    stop|quit)
        if stop; then echo "Agents Web stopped."; else echo "Agents Web is not running."; fi ;;
    restart)
        stop
        setsid -f "$APP/agents-web-tray" >/dev/null 2>&1
        echo "Agents Web restarted." ;;
    status)
        if running; then echo "running on http://127.0.0.1:$PORT/"; else echo "stopped"; exit 3; fi ;;
    log)
        exec tail -n 50 -f "$HOME/.local/share/agents-web/server.log" ;;
    version|--version|-v)
        version ;;
    update)
        if [ -f "$APP/install-kind" ]; then
            before="$(version)"
            python3 "$APP/server.py" --update || exit $?
            # a package replaced the files under the running server: start the new one (only if it changed)
            case "$KIND" in
                deb|rpm|pacman) if [ "$(version)" != "$before" ] && running; then
                                    stop; setsid -f "$APP/agents-web-tray" >/dev/null 2>&1
                                    echo "Agents Web restarted."
                                fi ;;
            esac
        # copies installed before 2.0 update through the installer
        elif [ "$(cat "$APP/source" 2>/dev/null)" = gitlab ]; then
            curl -fsSL "https://gitlab.com/gabriel17166/agents-web/-/raw/main/install.sh" | bash -s -- --gitlab
        else
            curl -fsSL "https://raw.githubusercontent.com/gabrielmf1998/Agents-Web/main/install.sh" | bash
        fi ;;
    uninstall)
        case "$KIND" in
            deb) echo "Remove the package: sudo apt remove agents-web" ;;
            rpm) echo "Remove the package: sudo dnf remove agents-web   (openSUSE: sudo zypper remove agents-web)" ;;
            pacman) echo "Remove the package: sudo pacman -R agents-web" ;;
            *) exec bash "$APP/install.sh" --uninstall "${@:2}" ;;
        esac ;;
    -h|--help|help)
        usage ;;
    *)
        usage >&2; exit 2 ;;
esac
